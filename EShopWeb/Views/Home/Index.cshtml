@model IEnumerable<EShopDataAccessModel.Product>
@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-6">Products List - Get Products - Classic </h1>        
</div>

@if (Model != null && Model.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Price</th>                
            </tr>
        </thead>
        <tbody>
            @* Iterate through each product in the Model *@
            @foreach (var product in Model)
            {
                <tr>
                    <td>@product.Id</td>
                    <td>@product.Name</td>
                    <td>@product.Price.ToString("C")</td> @* Format price as currency *@                    
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No products available.</p>
}
